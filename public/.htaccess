<Files "config.php">
  Order allow,deny
  Deny from all
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Cashfree API routing
  RewriteRule ^api/cashfree/create-order$ /api/cashfree.php?action=create-order [L,QSA]
  RewriteRule ^api/cashfree/verify-order$ /api/cashfree.php?action=verify-order [L,QSA]

  # 1. Direct social media crawlers (WhatsApp, Facebook, Twitter, Telegram, LinkedIn, Discord) to dynamic OpenGraph generator
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Facebot|Twitterbot|TelegramBot|LinkedInBot|Discordbot) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ /og.php [L,QSA]

  # 2. Standard SPA rewrite for all regular browsers
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

